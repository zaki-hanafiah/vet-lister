{
    "name": "vet-lister",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "next lint",
        "prettify": "prettier --write pages/**/*.ts{,x}"
    },
    "husky": {
        "hooks": {
            "pre-commit": "lint-staged"
        }
